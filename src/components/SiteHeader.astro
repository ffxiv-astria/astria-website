---
const { active = "home" } = Astro.props;
const links = [
  { id: "home", href: "/", label: "首页" },
  { id: "features", href: "/features/", label: "功能" },
  { id: "guides", href: "/guides/", label: "使用指南" },
  { id: "updates", href: "/updates/", label: "更新日志" },
];
---

{active !== "legal" && (
  <a class="skip-link" href="#main-content">
    跳到主要内容
  </a>
)}
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Astria天穹 首页">
      <img src="/brand/astria-app-icon.png" alt="" width="32" height="32" />
      <span>
        Astria<span class="brand-zh">天穹</span>
      </span>
    </a>
    <nav aria-label="主要导航">
      {links.map((link) => (
        <a
          class:list={[active === link.id && "active"]}
          aria-current={active === link.id ? "page" : undefined}
          href={link.href}
        >
          {link.label}
        </a>
      ))}
      <a
        class:list={["start-link", active === "start" && "active"]}
        aria-current={active === "start" ? "page" : undefined}
        href="/start/"
      >
        开始使用<span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>
<style>
  .skip-link {
    position: fixed;
    left: 16px;
    top: -80px;
    z-index: 100;
    padding: 12px 20px;
    background: var(--teal);
    color: #071014;
    border-radius: 8px;
  }
  .skip-link:focus {
    top: 12px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid rgba(184, 203, 223, 0.11);
    background: rgba(7, 9, 16, 0.9);
    backdrop-filter: blur(20px);
  }
  .header-inner {
    max-width: 1200px;
    width: calc(100% - 64px);
    min-height: 82px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    flex-shrink: 0;
    font-size: 21px;
    font-weight: 750;
    letter-spacing: -0.04em;
  }
  .brand img {
    border-radius: 9px;
    box-shadow: 0 0 24px rgba(98, 230, 221, 0.14);
  }
  .brand-zh {
    font-size: 16px;
    letter-spacing: 0;
    margin-left: 7px;
    font-weight: 600;
    color: var(--soft);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 14px;
    border-radius: 7px;
    color: var(--muted);
    font-size: 14px;
    white-space: nowrap;
    font-weight: 550;
  }
  nav a:hover,
  nav a.active {
    color: var(--text);
    background: rgba(255, 255, 255, 0.055);
  }
  nav .start-link {
    margin-left: 12px;
    border: 1px solid rgba(98, 230, 221, 0.35);
    color: var(--teal);
    gap: 17px;
  }
  nav .start-link:hover {
    background: rgba(98, 230, 221, 0.08);
  }
  @media (max-width: 760px) {
    .header-inner {
      width: calc(100% - 36px);
      min-height: 72px;
      flex-wrap: wrap;
      gap: 12px;
      padding-block: 16px;
    }
    .brand {
      font-size: 20px;
    }
    nav {
      width: 100%;
      overflow: auto;
      gap: 2px;
      margin-bottom: -3px;
      padding-bottom: 3px;
    }
    nav a {
      font-size: 13px;
      padding: 0 11px;
      min-height: 38px;
    }
    nav .start-link {
      margin-left: auto;
      gap: 8px;
    }
    .site-header {
      position: relative;
    }
  }
  @media (max-width: 380px) {
    nav a {
      font-size: 11px;
      padding-inline: 8px;
    }
    nav .start-link {
      gap: 6px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      backdrop-filter: none;
    }
  }
</style>

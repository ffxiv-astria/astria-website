---
interface Props {
  active?: string;
  home?: boolean;
}
const { active = "home", home = false } = Astro.props;
---

<header class="sb-header sb-wrap">
  <a class="sb-brand" href={home ? "#top" : "/"} aria-label="Astria天穹 首页">
    <img src="/brand/astria-app-icon.png" alt="" width="32" height="32" />
    <span class="sb-wordmark">ASTRIA</span>
    <span class="sb-brand-zh">天穹</span>
  </a>
  <nav aria-label="主导航">
    <a href={home ? "#features" : "/features/"} aria-current={active === "features" ? "page" : undefined}>能做什么</a>
    <a href={home ? "#ipad" : "/#ipad"}>iPad</a>
    <a href="/guides/" aria-current={active === "guides" ? "page" : undefined}>使用指南</a>
    <a href="/updates/" aria-current={active === "updates" ? "page" : undefined}>更新日志</a>
    <a class="sb-download-button" href={home ? "#download" : "/start/"} aria-current={active === "start" ? "page" : undefined}>下载 App</a>
  </nav>
</header>

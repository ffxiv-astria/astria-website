---
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import GuideCard from "../components/site/GuideCard.astro";
import { featureGroups, guides, updates } from "../data/site";
import gameData from "../assets/home/game-data.png";
import market from "../assets/home/market.png";
import partyFinder from "../assets/home/party-finder.png";
import ipadGearing from "../assets/screenshots/apple/ipad-gearing.png";
const featuredGuides = [
  "getting-started",
  "account-sync",
  "data-freshness",
].map((slug) => guides.find((guide) => guide.slug === slug)!);
const latest = updates.find((update) => update.kind === "Apple App")!;
---

<SiteLayout
  title="Astria天穹 — FF14 国服资料查询、市场行情与日常工具"
  description="为最终幻想14国服玩家准备的资料、行情、配装、日常工具与玩家社区。了解天穹 App 和微信小程序，找到适合自己的使用入口。"
>
  <section class="hero wrap">
    <div class="hero-copy">
      <a class="release-note" href="/updates/#ios-1-1-0">
        <span class="release-dot" aria-hidden="true"></span>Apple App{" "}
        {latest.version} 已发布<span aria-hidden="true">↗</span>
      </a>
      <p class="eyebrow">为艾欧泽亚的每一天</p>
      <h1>
        把冒险里的日常，
        <br />
        <span>安排好。</span>
      </h1>
      <p class="hero-description">
        查一件道具，看看行情，找一支队伍。
        <br />
        从上线前的准备，到下线后的惦记，
        <br class="hero-break" />
        天穹把常用的工具与玩家内容放在一起。
      </p>
      <div class="actions">
        <a class="button primary" href="/start/">
          开始使用<span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/features/">
          看看能做什么<span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="hero-platforms">
        iPhone · iPad · 微信小程序<span>为《最终幻想14》国服玩家制作</span>
      </p>
    </div>
    <div class="hero-visual">
      <span class="hero-orbit orbit-one" aria-hidden="true"></span>
      <span class="hero-orbit orbit-two" aria-hidden="true"></span>
      <span class="hero-spark" aria-hidden="true">
        ✦
      </span>
      <div class="hero-shot shot-back">
        <Image
          src={gameData}
          alt="天穹游戏资料界面，展示道具信息、制作配方与用途"
          width={430}
          format="webp"
          loading="eager"
        />
      </div>
      <div class="hero-shot shot-front">
        <Image
          src={market}
          alt="天穹市场界面，展示价格、成交记录与行情曲线"
          width={620}
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="visual-note">
        <span aria-hidden="true">✧</span>
        <span>熟悉的游戏，顺手的工具。</span>
      </div>
    </div>
  </section>
  <section class="entry-strip wrap" id="download" aria-label="选择使用入口">
    <div>
      <p>从你习惯的地方开始。</p>
      <span>下载 App，或在微信里随手查询。</span>
    </div>
    <a href="/start/#apple">
      <span class="entry-icon" aria-hidden="true">
        ↗
      </span>
      <span>
        天穹 App<small>iPhone 与 iPad</small>
      </span>
      <span aria-hidden="true">→</span>
    </a>
    <a href="/start/#wechat">
      <span class="entry-icon wechat-icon" aria-hidden="true">
        ◉
      </span>
      <span>
        微信小程序<small>搜索「FF14检索工具」</small>
      </span>
      <span aria-hidden="true">→</span>
    </a>
  </section>
  <section class="section wrap" id="features">
    <div class="section-heading">
      <div>
        <p class="eyebrow">从你需要的那件小事开始</p>
        <h2>
          一个问题，
          <br />
          总能找到一点线索。
        </h2>
      </div>
      <p>
        查资料、做准备、安排日常，
        <br />
        也看看其他玩家正在经历什么。
      </p>
    </div>
    <div class="scenario-grid">
      {featureGroups.map((group) => (
        <a
          class={`scenario scenario-${group.id}`}
          href={`/features/#${group.id}`}
        >
          <div class="scenario-top">
            <span class="number">{group.number}</span>
            <span aria-hidden="true">↗</span>
          </div>
          <h3>{group.title}</h3>
          <p>{group.description}</p>
          <div class="scenario-tags">
            {group.items.slice(0, 2).map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </a>
      ))}
      <a class="scenario scenario-all" href="/features/">
        <span class="number">EXPLORE</span>
        <h3>
          还有哪些
          <br />
          顺手的小工具？
        </h3>
        <span class="text-link">
          完整功能介绍<span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>
  <section class="showcase section section-top">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">先看几眼</p>
          <h2>
            信息放在一起，
            <br />
            准备就有了头绪。
          </h2>
        </div>
        <p>
          真实应用界面。
          <br />
          从资料、行情到队伍，一步步继续探索。
        </p>
      </div>
      <div class="showcase-grid">
        <figure>
          <div class="screen-frame">
            <Image
              src={gameData}
              alt="道具详情页面，包含制作配方、用途和获取来源"
              width={720}
              format="webp"
              loading="lazy"
            />
          </div>
          <figcaption>
            <span>01 / 资料</span>
            <h3>从一件道具，继续查下去。</h3>
            <p>配方、来源、用途，沿着关联信息找到下一步。</p>
          </figcaption>
        </figure>
        <figure>
          <div class="screen-frame">
            <Image
              src={market}
              alt="市场行情页面，包含当前价格、成交与走势"
              width={720}
              format="webp"
              loading="lazy"
            />
          </div>
          <figcaption>
            <span>02 / 行情</span>
            <h3>买卖之前，多一点依据。</h3>
            <p>结合价格、成交和更新时间，做好自己的判断。</p>
          </figcaption>
        </figure>
        <figure>
          <div class="screen-frame">
            <Image
              src={partyFinder}
              alt="跨服招募页面，包含副本筛选与招募队伍列表"
              width={720}
              format="webp"
              loading="lazy"
            />
          </div>
          <figcaption>
            <span>03 / 队伍</span>
            <h3>找到一起出发的人。</h3>
            <p>按副本与玩法筛选，在游戏外也能翻翻招募板。</p>
          </figcaption>
        </figure>
      </div>
      <p class="screenshot-note">
        界面示例；数据内容与功能开放情况以实际客户端为准。
      </p>
    </div>
  </section>
  <section class="workspace section wrap">
    <div class="workspace-copy">
      <p class="eyebrow">给更大的屏幕，也多一点空间</p>
      <h2>
        摊开来看，
        <br />
        细节就有了位置。
      </h2>
      <p>
        在 iPad 上，把配装、属性和说明，
        <br />
        并列放进更宽的工作空间里。
      </p>
      <a class="text-link" href="/features/#planning">
        了解配装与规划<span aria-hidden="true">↗</span>
      </a>
      <span class="workspace-caption">iPad App 界面 · 演示配装与示例数据</span>
    </div>
    <figure class="workspace-screen">
      <Image
        src={ipadGearing}
        alt="天穹 iPad 配装详情示例，核心数据、属性和装备并列展示，使用演示数据"
        width={1400}
        format="webp"
        loading="lazy"
      />
    </figure>
  </section>
  <section class="section wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">不用自己摸索所有细节</p>
        <h2>用之前，先看这一篇。</h2>
      </div>
      <a class="text-link" href="/guides/">
        全部使用指南<span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="guide-grid">
      {featuredGuides.map((guide) => (
        <GuideCard guide={guide} />
      ))}
    </div>
  </section>
  <section class="update-section section-top wrap">
    <div>
      <p class="eyebrow">最近更新</p>
      <h2>天穹，还在慢慢变好。</h2>
    </div>
    <a href="/updates/#ios-1-1-0" class="latest-update">
      <div class="pills">
        <span class="pill teal">
          {latest.kind} {latest.version}
        </span>
        <time datetime={latest.date}>{latest.date.replaceAll("-", ".")}</time>
      </div>
      <h3>{latest.title}</h3>
      <p>{latest.summary}</p>
      <span class="text-link">
        查看更新记录<span aria-hidden="true">→</span>
      </span>
    </a>
  </section>
  <section class="wrap closing">
    <div class="cta-panel">
      <div>
        <h2>下一次冒险，带上天穹。</h2>
        <p>从一个顺手的入口，开始安排游戏里的日常。</p>
      </div>
      <div class="actions">
        <a class="button primary" href="/start/">
          选择使用入口<span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 35px;
    min-height: 720px;
    padding-block: 65px 85px;
  }
  .hero-copy {
    position: relative;
    z-index: 2;
  }
  .release-note {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    color: var(--soft);
    margin-bottom: 42px;
    padding: 7px 10px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.025);
  }
  .release-note > span:last-child {
    margin-left: 8px;
    color: var(--teal);
  }
  .release-dot {
    height: 5px;
    width: 5px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 13px rgba(98, 230, 221, 0.6);
  }
  .hero h1 {
    font-size: clamp(42px, 4.6vw, 64px);
    line-height: 1.33;
    letter-spacing: -0.045em;
    margin-bottom: 23px;
  }
  .hero h1 > span {
    color: var(--teal);
  }
  .hero-description {
    font-size: 15px;
    line-height: 2;
    color: var(--soft);
    margin: 0;
  }
  .hero-platforms {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.8;
    margin: 24px 0 0;
  }
  .hero-platforms > span {
    display: block;
    color: #8996a8;
    font-size: 10px;
    margin-top: 3px;
  }
  .hero-visual {
    position: relative;
    height: 570px;
    isolation: isolate;
  }
  .hero-shot {
    position: absolute;
    width: 53%;
    border: 1px solid rgba(207, 232, 245, 0.2);
    border-radius: 25px;
    overflow: hidden;
    background: #101722;
    box-shadow: 0 22px 55px rgba(0, 0, 0, 0.45);
  }
  .hero-shot {
    max-height: 82%;
  }
  .hero-shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot-back {
    left: 5%;
    top: 4%;
    transform: rotate(-8deg);
    z-index: 1;
    opacity: 0.85;
  }
  .shot-front {
    left: 39%;
    top: 10%;
    transform: rotate(7deg);
    z-index: 2;
  }
  .hero-orbit {
    position: absolute;
    z-index: -1;
    inset: 10%;
    border: 1px solid rgba(98, 230, 221, 0.09);
    border-radius: 50%;
    transform: rotate(-25deg);
  }
  .orbit-two {
    inset: 20% -8%;
    transform: rotate(25deg);
    border-color: rgba(159, 140, 255, 0.11);
  }
  .hero-spark {
    position: absolute;
    color: var(--teal);
    font-size: 55px;
    left: 0;
    top: 63%;
    font-weight: 300;
  }
  .visual-note {
    display: flex;
    align-items: center;
    gap: 10px;
    position: absolute;
    bottom: 0;
    right: 15%;
    font-size: 11px;
    color: var(--muted);
  }
  .visual-note > span:first-child {
    font-size: 20px;
    color: var(--teal);
  }
  .entry-strip {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    align-items: center;
    border-block: 1px solid var(--line);
    padding-block: 27px;
    gap: 36px;
  }
  .entry-strip > div p {
    font-size: 16px;
    margin: 0 0 4px;
  }
  .entry-strip > div > span {
    font-size: 12px;
    color: var(--muted);
  }
  .entry-strip > a {
    display: flex;
    align-items: center;
    gap: 15px;
    padding-left: 30px;
    border-left: 1px solid var(--line);
    font-size: 14px;
  }
  .entry-strip > a > span:last-child {
    margin-left: auto;
    color: var(--teal);
  }
  .entry-strip a small {
    display: block;
    font-size: 11px;
    color: var(--muted);
    margin-top: 5px;
  }
  .entry-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--teal);
    font-size: 23px;
    border: 1px solid rgba(98, 230, 221, 0.25);
    border-radius: 10px;
    background: rgba(98, 230, 221, 0.04);
  }
  .wechat-icon {
    color: #8ce3a1;
  }
  .scenario-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .scenario {
    display: flex;
    flex-direction: column;
    padding: 30px 30px 26px;
    min-height: 280px;
    background: rgba(17, 23, 33, 0.5);
    border-bottom: 1px solid var(--line);
    border-right: 1px solid var(--line);
    transition: background 0.2s;
  }
  .scenario:nth-child(3n) {
    border-right: 0;
  }
  .scenario:nth-child(n + 4) {
    border-bottom: 0;
  }
  .scenario:hover {
    background: rgba(98, 230, 221, 0.055);
  }
  .scenario-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }
  .scenario-top > span:last-child {
    font-size: 17px;
    color: var(--muted);
  }
  .scenario h3 {
    font-size: 20px;
    margin-bottom: 13px;
  }
  .scenario p {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 25px;
  }
  .scenario-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: auto;
    color: var(--soft);
    font-size: 10px;
  }
  .scenario-tags span {
    border-bottom: 1px solid var(--line);
    padding-bottom: 3px;
  }
  .scenario-all {
    background: linear-gradient(
      135deg,
      rgba(98, 230, 221, 0.09),
      rgba(98, 230, 221, 0.025)
    );
    justify-content: space-between;
  }
  .scenario-all h3 {
    font-size: 28px;
    line-height: 1.6;
    margin: 20px 0;
  }
  .scenario-all .text-link {
    font-size: 12px;
  }
  .showcase {
    background: rgba(255, 255, 255, 0.012);
  }
  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
  }
  .showcase figure {
    margin: 0;
  }
  .screen-frame {
    background: linear-gradient(
      130deg,
      rgba(98, 230, 221, 0.08),
      rgba(159, 140, 255, 0.04)
    );
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 27px 35px 0;
    overflow: hidden;
    height: 460px;
  }
  .screen-frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 15px 15px 0 0;
    box-shadow: 0 0 35px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .showcase figcaption {
    margin-top: 25px;
  }
  .showcase figcaption > span {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--teal);
  }
  .showcase figcaption h3 {
    font-size: 18px;
    margin: 11px 0;
  }
  .showcase figcaption p {
    font-size: 12px;
    color: var(--muted);
    margin: 0;
  }
  .screenshot-note {
    font-size: 10px;
    color: #8d9aac;
    margin: 28px 0 0;
  }
  .update-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    padding-block: 65px;
  }
  .update-section h2 {
    font-size: 32px;
  }
  .latest-update time {
    font-size: 11px;
    color: var(--muted);
    align-self: center;
    margin-left: auto;
  }
  .latest-update h3 {
    margin: 18px 0 11px;
    font-size: 23px;
  }
  .latest-update p {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 15px;
  }
  .latest-update .text-link {
    font-size: 12px;
  }
  .closing {
    padding-block: 10px 95px;
  }
  .workspace {
    display: grid;
    grid-template-columns: 0.8fr 1.3fr;
    gap: 65px;
    align-items: center;
    border-bottom: 1px solid var(--line);
  }
  .workspace-copy > p:not(.eyebrow) {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.95;
  }
  .workspace-caption {
    display: block;
    font-size: 10px;
    color: var(--muted);
    margin-top: 25px;
  }
  .workspace-screen {
    margin: 0;
    height: 520px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    background: #f7f8fb;
    overflow: hidden;
    box-shadow: var(--shadow);
    transform: perspective(1800px) rotateY(-5deg) rotateX(2deg);
  }
  .workspace-screen img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (min-width: 1250px) {
    .hero {
      grid-template-columns: 1fr 1.05fr;
    }
    .hero-visual {
      height: 625px;
    }
    .hero {
      min-height: 790px;
    }
    .screen-frame {
      height: 510px;
    }
  }
  @media (max-width: 950px) {
    .workspace {
      gap: 35px;
      grid-template-columns: 0.85fr 1.2fr;
    }
    .workspace-screen {
      height: 450px;
    }
    .hero {
      grid-template-columns: 1fr 1fr;
      gap: 5px;
      min-height: 620px;
    }
    .hero-visual {
      height: 440px;
    }
    .hero h1 {
      font-size: 44px;
    }
    .hero-description {
      font-size: 14px;
    }
    .hero-shot {
      border-radius: 20px;
    }
    .hero-break {
      display: none;
    }
    .release-note {
      margin-bottom: 30px;
    }
    .entry-strip {
      gap: 20px;
      grid-template-columns: 1fr 1fr;
    }
    .entry-strip > div {
      grid-column: 1/-1;
    }
    .entry-strip > a {
      border-left: 0;
      padding-left: 0;
    }
    .scenario {
      padding: 25px;
    }
    .scenario-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .scenario:nth-child(3n) {
      border-right: 1px solid var(--line);
    }
    .scenario:nth-child(2n) {
      border-right: 0;
    }
    .scenario:nth-child(n + 4) {
      border-bottom: 1px solid var(--line);
    }
    .scenario:nth-child(n + 5) {
      border-bottom: 0;
    }
    .showcase-grid {
      gap: 18px;
    }
    .screen-frame {
      padding: 22px 20px 0;
      height: 340px;
    }
    .update-section {
      gap: 35px;
    }
  }
  @media (max-width: 650px) {
    .workspace {
      grid-template-columns: 1fr;
      gap: 35px;
    }
    .workspace-screen {
      height: 420px;
      border-radius: 13px;
      transform: none;
    }
    .workspace-copy > p:not(.eyebrow) {
      font-size: 13px;
    }
    .workspace-caption {
      margin-top: 17px;
    }
    .hero {
      display: flex;
      flex-direction: column;
      padding-block: 38px 35px;
      gap: 28px;
      align-items: stretch;
      min-height: 0;
    }
    .hero h1 {
      font-size: clamp(32px, 10.8vw, 46px);
    }
    .hero-description {
      font-size: 14px;
    }
    .release-note {
      margin-bottom: 32px;
    }
    .hero-visual {
      height: 450px;
      margin-inline: 10px;
    }
    .hero-shot {
      width: 45%;
      border-radius: 20px;
    }
    .shot-back {
      left: 10%;

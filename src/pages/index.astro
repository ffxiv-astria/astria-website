---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Polaroid from "../components/starbook/Polaroid.astro";
import { site } from "../data/site";
import { starbookTasks, starbookExtras, starbookSky } from "../data/starbook";
import { pageStructuredData, socialImage } from "../lib/seo";
import ipadGearing from "../assets/screenshots/apple/ipad-gearing.png";
import "../styles/starbook.css";

const title = "Astria天穹 — FF14 国服资料查询、市场行情与日常工具";
const description =
  "为最终幻想14国服玩家准备的资料、市场行情、采集时钟、天气、配装和玩家社区。下载天穹 App，或在微信搜索 FF14检索工具小程序。";
const sky = starbookSky();
---

<Layout
  title={title}
  description={description}
  canonicalPath="/"
  ogImage={socialImage}
  ogImageWidth={1200}
  ogImageHeight={630}
  structuredData={pageStructuredData("/", title, description)}
>
  <main id="main-content" class="starbook" data-starbook>
    <a class="sb-skip" href="#starbook-content">
      跳到主要内容
    </a>
    <section class="sb-hero-region" id="top">
      <div class="sb-sky" aria-hidden="true">
        {sky.map((star) => (
          <span
            style={`left:${star.x}%;top:${star.y}%;width:${star.size}px;height:${star.size}px;opacity:${star.opacity}`}
          ></span>
        ))}
      </div>
      <header class="sb-header sb-wrap">
        <a class="sb-brand" href="#top" aria-label="Astria天穹 首页">
          <img src="/brand/astria-app-icon.png" alt="" width="32" height="32" />
          <span class="sb-wordmark">ASTRIA</span>
          <span class="sb-brand-zh">天穹</span>
        </a>
        <nav aria-label="主导航">
          <a href="#features">能做什么</a>
          <a href="#ipad">iPad</a>
          <a href="/guides/">使用指南</a>
          <a href="/updates/">更新日志</a>
          <a class="sb-download-button" href="#download">
            下载 App
          </a>
        </nav>
      </header>
      <div class="sb-hero sb-wrap" id="starbook-content" tabindex="-1">
        <div class="sb-hero-copy">
          <a class="sb-release" href="/updates/">
            1.1.0 新到：萌新招待 · 陆行鸟礼物站 ·{" "}
            <span class="sb-release-last">水晶冲突排行榜 →</span>
          </a>
          <h1>
            冒险者的
            <br />
            <span>随身星图</span>
          </h1>
          <p class="sb-intro">
            查道具、看行情、守采集点、等天气、找队伍。上线前要准备的、下线后还惦记的，天穹都替你记在这一本里。
          </p>
          <div class="sb-hero-download">
            <a class="sb-store-badge" href={site.appStoreURL}>
              <img
                src="/brand/download-on-the-app-store-zh-cn.svg"
                alt="在 App Store 下载"
                height="50"
              />
            </a>
            <span>没有 iPhone？微信搜「FF14检索工具」</span>
          </div>
        </div>
        <div class="sb-collage">
          <svg
            class="sb-constellation"
            aria-hidden="true"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
          >
            <polyline
              points="23,9 77,1 50,41 23,9"
              fill="none"
              stroke="currentColor"
              stroke-opacity="0.55"
              stroke-width="1"
              stroke-dasharray="2 6"
              vector-effect="non-scaling-stroke"
            />
          </svg>
          <Polaroid
            class="sb-hero-item"
            image={starbookTasks[0].image}
            alt="天穹 App 道具详情：紫水晶的配方与材料界面示例"
            caption="紫水晶怎么做？"
            tape="gold"
            eager
          >
            <span slot="caption">
              紫水晶<span class="sb-caption-tail">怎么做？</span>
            </span>
          </Polaroid>
          <Polaroid
            class="sb-hero-market"
            image={starbookTasks[1].image}
            alt="天穹 App 市价查询：热度榜界面示例"
            caption="今天什么最热？"
            tape="blue"
            eager
          >
            <span slot="caption">
              今天<span class="sb-caption-tail">什么最热？</span>
            </span>
          </Polaroid>
          <Polaroid
            class="sb-hero-gatherer"
            image={starbookTasks[2].image}
            alt="天穹 App 采集时钟：艾欧泽亚时间与限时采集点界面示例"
            caption="ET 12:00 的采集点"
            pin
            eager
          />
          <p class="sb-collage-note sb-collage-note-blue">
            ↑ 配方和材料，一页看完
          </p>
          <p class="sb-collage-note sb-collage-note-gold">
            ↙ 限时采集点，提前做准备
          </p>
          <div class="sb-stamp" aria-hidden="true">
            <span>天穹</span>
            <span>EORZEA</span>
          </div>
          <p class="sb-image-note">
            界面示例；部分内容为演示数据，实际以客户端为准。
          </p>
        </div>
      </div>
    </section>
    <section
      class="sb-todo sb-wrap"
      id="features"
      aria-labelledby="sb-todo-title"
    >
      <div class="sb-notebook">
        <span class="sb-notebook-margin" aria-hidden="true"></span>
        <div class="sb-notebook-heading">
          <h2 id="sb-todo-title">今天上线前</h2>
          <output
            class="sb-count"
            data-task-count
            aria-live="polite"
            aria-atomic="true"
          >
            已完成 1 / {starbookTasks.length}
          </output>
        </div>
        <div class="sb-tasks">
          {starbookTasks.map((task, index) => (
            <div class="sb-task">
              <label>
                <input type="checkbox" checked={index === 0} data-task-check />
                <span>{task.text}</span>
              </label>
              <button
                type="button"
                data-pick={index}
                data-tool={task.tool}
                data-body={task.body}
                aria-pressed={index === 0 ? "true" : "false"}
                aria-controls={`sb-pinned-view sb-inline-preview-${index}`}
              >
                → {task.tool}
              </button>
              <div
                class="sb-inline-preview"
                id={`sb-inline-preview-${index}`}
                data-inline-slot={index}
                hidden={index !== 0}
              >
                <Polaroid
                  class="sb-inline-photo"
                  image={task.image}
                  alt={`天穹 App ${task.tool}页面示例`}
                  caption={task.tool}
                  pin
                  sizes="240px"
                />
                <p>{task.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="sb-pinned-view" id="sb-pinned-view">
        <figure class="sb-polaroid sb-pinned-photo">
          <svg
            class="sb-pin"
            aria-hidden="true"
            width="34"
            height="34"
            viewBox="0 0 24 24"
          >
            <path
              d="M12 0C13 7 17 11 24 12C17 13 13 17 12 24C11 17 7 13 0 12C7 11 11 7 12 0Z"
              fill="currentColor"
            />
          </svg>
          {starbookTasks.map((task, index) => (
            <Image
              src={task.image}
              alt={`天穹 App ${task.tool}页面示例`}
              width={720}
              widths={[320, 480, 640, 960]}
              sizes="(max-width:650px) 80vw, 320px"
              format="webp"
              loading={index === 0 ? "eager" : "lazy"}
              hidden={index !== 0}
              data-pin-image={index}
            />
          ))}
          <figcaption data-pin-caption>{starbookTasks[0].tool}</figcaption>
        </figure>
        <p
          class="sb-pin-description"
          data-pin-description
          aria-live="polite"
          aria-atomic="true"
        >
          {starbookTasks[0].body}
        </p>
        <p class="sb-pin-hint">
          <span class="sb-pin-hint-desktop">点左边的标签，换一张钉上来</span>
          <span class="sb-pin-hint-stacked">点上方的标签，换一张钉上来</span>
        </p>
      </div>
    </section>
    <section class="sb-extras sb-wrap" aria-labelledby="sb-extras-title">
      <div class="sb-extras-heading">
        <h2 id="sb-extras-title">本子里还夹着几页</h2>
        <span>收集、解谜、看轮换</span>
      </div>
      <div class="sb-extra-pages">
        {starbookExtras.map((extra) => (
          <Polaroid
            class="sb-extra-photo"
            image={extra.image}
            alt={extra.alt}
            caption={extra.caption}
            tape={extra.tape}
            rotation={extra.rotation}
            sizes="(max-width:650px) 60vw, 250px"
          />
        ))}
        <aside class="sb-sticky-note">
          <p>还有这些：</p>
          <ul>
            <li>零式英雄榜与角色战绩</li>
            <li>云雾街玩家社区</li>
            <li>宏方案库</li>
          </ul>
          <p>
            App
            里还能连上石之家：幻化、攻略、招募板与官方活动。部分功能需要登录天穹，并按页面提示连接叨鱼账号。
          </p>
        </aside>
      </div>
    </section>
    <section class="sb-ipad sb-wrap" id="ipad" aria-labelledby="sb-ipad-title">
      <p class="sb-latin-label">A WIDER SKY</p>
      <h2 id="sb-ipad-title">在大桌面上摊开</h2>
      <p class="sb-ipad-note">iPad 上，核心数据、魔晶石和属性面板一页看全 ↓</p>
      <div class="sb-ipad-frame">
        <span class="sb-ipad-tape sb-ipad-tape-left" aria-hidden="true"></span>
        <span class="sb-ipad-tape sb-ipad-tape-right" aria-hidden="true"></span>
        <Image
          src={ipadGearing}
          alt="天穹 iPad 配装详情示例：核心数据、魔晶石和属性面板，使用演示数据"
          width={1600}
          widths={[640, 1000, 1400, 1800]}
          sizes="(max-width:1100px) 90vw, 1000px"
          format="webp"
          loading="lazy"
        />
      </div>
      <p class="sb-mac-note">
        iPad 版也能在搭载 Apple M1 或更新芯片的 Mac 上使用，以 App Store
        兼容说明为准。
      </p>
    </section>
    <section
      class="sb-download sb-wrap"
      id="download"
      aria-labelledby="sb-download-title"
    >
      <div class="sb-download-card">
        <svg
          class="sb-scissors"
          aria-hidden="true"
          width="30"
          height="30"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <circle cx="6" cy="6" r="3" />
          <circle cx="6" cy="18" r="3" />
          <path d="M8.5 7.5L20 18M8.5 16.5L20 6" />
        </svg>
        <div class="sb-download-copy">
          <h2 id="sb-download-title">
            带上天穹，
            <br />
            去冒险。
          </h2>
          <p>两个入口，挑顺手的那个</p>
        </div>
        <div class="sb-download-options">
          <div class="sb-app-entry">
            <span>天穹 App</span>
            <strong>iPhone 与 iPad</strong>
            <a class="sb-store-badge" href={site.appStoreURL}>
              <img
                src="/brand/download-on-the-app-store-zh-cn.svg"
                alt="在 App Store 下载"
                height="50"
              />
            </a>
          </div>
          <div class="sb-wechat-entry">
            <img
              src="/brand/wechat-miniapp-code.jpg"
              alt="微信小程序「FF14检索工具」官方小程序码"
              width="96"
              height="96"
            />
            <div>
              <span>微信小程序</span>
              <strong>FF14检索工具</strong>
              <span>扫码，或在微信里搜索</span>
            </div>
          </div>
        </div>
      </div>
      <footer class="sb-footer">
        <span>为《最终幻想14》国服玩家制作的非官方工具</span>
        <nav aria-label="法律与公共服务">
          <a href="/guides/">使用指南</a>
          <a href="/updates/">更新日志</a>
          <a href="/legal/privacy/">隐私政策</a>
          <a href="/legal/terms/">服务协议</a>
          <a href="/account-deletion/">账号注销</a>
          <a href="/legal/ffxiv-materials/">法律与数据来源</a>
        </nav>
      </footer>
    </section>
  </main>
</Layout>
<script>
  const root = document.querySelector<HTMLElement>("[data-starbook]");
  if (root) {
    const checks = [
      ...root.querySelectorAll<HTMLInputElement>("[data-task-check]"),
    ];
    const count = root.querySelector<HTMLOutputElement>("[data-task-count]");
    const picks = [...root.querySelectorAll<HTMLButtonElement>("[data-pick]")];
    const images = [
      ...root.querySelectorAll<HTMLImageElement>("[data-pin-image]"),
    ];
    const inlinePreviews = [
      ...root.querySelectorAll<HTMLElement>("[data-inline-slot]"),
    ];
    const caption = root.querySelector<HTMLElement>("[data-pin-caption]");
    const description = root.querySelector<HTMLElement>(
      "[data-pin-description]",
    );
    const updateCount = () => {
      if (count)
        count.textContent = `已完成 ${checks.filter((check) => check.checked).length} / ${checks.length}`;
    };
    checks.forEach((check) => check.addEventListener("change", updateCount));
    updateCount();
    picks.forEach((pick) =>
      pick.addEventListener("click", () => {
        picks.forEach((button) =>
          button.setAttribute("aria-pressed", String(button === pick)),
        );
        images.forEach(
          (image) =>
            (image.hidden = image.dataset.pinImage !== pick.dataset.pick),
        );
        inlinePreviews.forEach(
          (preview) =>
            (preview.hidden = preview.dataset.inlineSlot !== pick.dataset.pick),
        );
        if (caption) caption.textContent = pick.dataset.tool ?? "";
        if (description) description.textContent = pick.dataset.body ?? "";
        const inlinePreview = inlinePreviews.find(
          (preview) => preview.dataset.inlineSlot === pick.dataset.pick,
        );
        if (inlinePreview && window.matchMedia("(max-width: 834px)").matches) {
          requestAnimationFrame(() => {
            if (
              !inlinePreview.hidden &&
              window.matchMedia("(max-width: 834px)").matches
            ) {
              inlinePreview.scrollIntoView({
                block: "nearest",
                behavior: "instant",
              });
            }
          });
        }
      }),
    );
  }
</script>

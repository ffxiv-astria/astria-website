---
import SiteLayout from "../../layouts/StarbookLayout.astro";
import { guides } from "../../data/site";
export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}
const { guide } = Astro.props;
const related = guide.related.map((slug: string) =>
  guides.find((item) => item.slug === slug)!,
);
---

<SiteLayout
  title={`${guide.title} — 天穹 FF14 使用指南`}
  description={guide.summary}
  active="guides"
>
  <div class="wrap">
    <section class="page-hero article-hero">
      <nav class="breadcrumbs" aria-label="面包屑">
        <a href="/">首页</a>
        <span aria-hidden="true">/</span>
        <a href="/guides/">使用指南</a>
        <span aria-hidden="true">/</span>
        <span>{guide.category}</span>
      </nav>
      <div class="pills">
        <span class="pill">{guide.category}</span>
        <span class="reading-time">约 {guide.minutes}</span>
      </div>
      <h1>{guide.title}</h1>
      <p class="lede">{guide.summary}</p>
    </section>
    <div class="article-layout">
      <article class="article-body">
        {guide.sections.map(
          (section: { title: string; paragraphs: string[] }, index: number) => (
            <section id={`section-${index + 1}`}>
              <h2>{section.title}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </section>
          ),
        )}
        {guide.slug === "privacy" && (
          <div class="note">
            <p>
              <a href="/legal/privacy/">隐私政策</a> ·{" "}
              <a href="/legal/terms/">服务协议</a> ·{" "}
              <a href="/legal/ffxiv-materials/">法律与数据来源</a>
            </p>
            <a class="text-link" href="/account-deletion/">
              进入账号注销页面<span aria-hidden="true">↗</span>
            </a>
          </div>
        )}
        {guide.slug === "feedback" && (
          <a class="button" href="mailto:chenxmeow@icloud.com">
            联系支持邮箱<span aria-hidden="true">↗</span>
          </a>
        )}
        <div class="related-guides">
          <h2>接下来，你可能还想了解</h2>
          {related.map((item: (typeof guides)[number]) => (
            <a href={`/guides/${item.slug}/`}>
              {item.title}
              <span aria-hidden="true"> ↗</span>
            </a>
          ))}
        </div>
        <div class="article-bottom">
          <a class="text-link" href="/guides/">
            <span aria-hidden="true">←</span>返回全部指南
          </a>
        </div>
      </article>
      <aside class="article-aside" aria-label="本篇内容">
        <p>本篇内容</p>
        <nav aria-label="文章目录">
          {guide.sections.map((section: { title: string }, index: number) => (
            <a href={`#section-${index + 1}`}>{section.title}</a>
          ))}
        </nav>
      </aside>
    </div>
  </div>
</SiteLayout>
<style>
  .article-hero {
    max-width: 840px;
    padding-bottom: 48px;
  }
  .article-hero h1 {
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.45;
    margin: 22px 0 18px;
  }
  .article-hero .lede {
    font-size: 17px;
    max-width: 720px;
  }
  .reading-time {
    font-size: 13px;
    color: var(--muted);
    align-self: center;
    margin-left: 5px;
  }
  .breadcrumbs {
    margin-bottom: 36px;
  }
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 840px) minmax(220px, 1fr);
    align-items: start;
    gap: 48px;
    padding-bottom: 104px;
  }
  .article-body {
    --text: #202b3d;
    --muted: #657083;
    --teal: #756129;
    --line: rgba(31, 43, 60, 0.16);
    min-width: 0;
    position: relative;
    padding: 48px 52px;
    border-radius: 4px;
    background: #f4efe3;
    color: var(--text);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
  }
  .article-body::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 24px;
    width: 1px;
    background: rgba(163, 130, 63, 0.25);
    pointer-events: none;
  }
  .article-body section {
    scroll-margin-top: 32px;
  }
  .article-body section + section {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .article-body h2 {
    margin: 0 0 20px;
    font-family: "Starbook Noto Serif SC", serif;
    font-size: 25px;
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: 0.02em;
  }
  .article-body p {
    font-size: 16px;
    line-height: 2;
    margin: 16px 0 0;
    overflow-wrap: anywhere;
  }
  .article-body a {
    color: #65501f;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .article-body a:hover {
    color: #202b3d;
  }
  .article-body .note {
    background: #eae2ce;
    border: 1px solid var(--line);
    border-left: 3px solid #b7974e;
    border-radius: 3px;
    padding: 20px 24px;
    margin-top: 36px;
  }
  .article-body .note p {
    margin: 0 0 16px;
  }
  .article-body .button {
    margin-top: 32px;
    text-decoration: none;
    color: #1a1430;
    background: #e8c77a;
  }
  .related-guides {
    margin-top: 44px;
    padding-top: 32px;
    border-top: 1px dashed rgba(117, 97, 41, 0.4);
  }
  .related-guides h2 {
    font-size: 22px;
    margin-bottom: 20px;
  }
  .related-guides a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    line-height: 1.8;
    padding-block: 12px;
    font-size: 15px;
  }
  .related-guides a + a {
    border-top: 1px solid var(--line);
  }
  .related-guides a span {
    flex: none;
  }
  .article-bottom {
    margin-top: 28px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .article-body a:focus-visible {
    outline-color: #65501f;
  }
  .article-aside {
    position: sticky;
    top: 32px;
    min-width: 0;
    background: #0d1240;
    padding: 28px 28px 24px;
    border: 1px solid rgba(141, 168, 255, 0.35);
    border-radius: 4px;
  }
  .article-aside > p {
    margin: 0 0 16px;
    font-family: "Starbook Long Cang", cursive;
    color: #e8c77a;
    font-size: 28px;
    line-height: 1.3;
  }
  .article-aside nav {
    display: flex;
    flex-direction: column;
  }
  .article-aside a {
    display: block;
    padding-block: 13px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }
  .article-aside a:hover {
    color: #e8c77a;
  }
  @media (max-width: 1000px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .article-aside {
      order: -1;
      position: static;
      padding: 24px 28px;
    }
    .article-aside nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px 24px;
    }
    .article-aside a {
      padding-block: 8px;
      border-top: 0;
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }
  @media (max-width: 650px) {
    .article-hero h1 {
      font-size: 30px;
      line-height: 1.5;
    }
    .article-hero .lede {
      font-size: 16px;
    }
    .article-hero {
      padding-bottom: 32px;
    }
    .breadcrumbs {
      font-size: 13px;
      margin-bottom: 28px;
    }
    .article-layout {
      padding-bottom: 64px;
    }
    .article-body {
      padding: 32px 26px 32px 30px;
    }
    .article-body::before {
      left: 14px;
    }
    .article-body h2 {
      font-size: 22px;
    }
    .article-body p {
      font-size: 16px;
      line-height: 1.95;
    }
    .article-body .note {
      padding: 18px;
    }
    .article-aside {
      padding: 22px 24px;
    }
    .article-aside nav {
      flex-direction: column;
      gap: 0;
    }
    .article-aside a {
      padding-block: 10px;
    }
    .related-guides h2 {
      font-size: 21px;
    }
  }
</style>

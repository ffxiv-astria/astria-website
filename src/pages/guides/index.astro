---
import SiteLayout from "../../layouts/StarbookLayout.astro";
import { guides, guideCategories, site } from "../../data/site";
---

<SiteLayout
  title="天穹 FF14 工具使用指南与帮助 — 账号、行情与房屋订阅"
  description="了解天穹 App 与微信小程序的账号、数据同步、行情时效、房屋订阅、分享打开方式与反馈流程。"
  active="guides"
>
  <section class="page-hero wrap">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href="/">首页</a>
      <span aria-hidden="true">/</span>
      <span>使用指南</span>
    </nav>
    <p class="eyebrow">有些小问题，在这里解答</p>
    <h1>
      用得顺手，
      <br />
      从弄清这一点开始。
    </h1>
    <p class="lede">
      账号怎么接着用，行情为什么会有延迟，分享怎么打开。
      <br />
      把常见的问题，写成几篇短一点的说明。
    </p>
    <div class="guide-search">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <circle
          cx="10.5"
          cy="10.5"
          r="6.5"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <path
          d="m16 16 4 4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
      <label class="visually-hidden" for="guide-search">
        搜索使用指南
      </label>
      <input
        id="guide-search"
        type="search"
        placeholder="搜索账号、行情、分享……"
        autocomplete="off"
        aria-controls="guide-results"
      />
    </div>
  </section>
  <section class="wrap guides-library" aria-label="使用指南文章">
    <div class="guide-toolbar">
      <div class="guide-filters" role="group" aria-label="按指南分类筛选">
        <button
          type="button"
          class="selected"
          data-category="all"
          aria-pressed="true"
        >
          全部指南
        </button>
        {guideCategories.map((category) => (
          <button type="button" data-category={category} aria-pressed="false">
            {category}
          </button>
        ))}
      </div>
      <p id="guide-count" role="status" aria-live="polite">
        共 {guides.length} 篇指南
      </p>
    </div>
    <div class="guide-grid" id="guide-results">
      {guides.map((guide, index) => (
        <div
          class="searchable-guide"
          data-category={guide.category}
          data-search={`${guide.title} ${guide.summary} ${guide.category}`}
        >
          <a class="guide-card" href={`/guides/${guide.slug}/`}>
            <div class="guide-card-heading">
              <span class="category">{guide.category}</span>
              <span class="guide-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>
            <h2>{guide.title}</h2>
            <p>{guide.summary}</p>
            <div class="card-bottom">
              <span>约 {guide.minutes}</span>
              <span aria-hidden="true">↗</span>
            </div>
          </a>
        </div>
      ))}
    </div>
    <div class="empty-guides" id="empty-guides" hidden>
      <h2>暂时没有找到对应的指南。</h2>
      <p>试试更短的关键词，例如“账号”“行情”或“分享”。</p>
      <button type="button" class="button" id="reset-guides">
        查看全部指南<span aria-hidden="true">→</span>
      </button>
    </div>
  </section>
  <section class="wrap help-contact">
    <div class="cta-panel">
      <div>
        <h2>还没找到答案？</h2>
        <p>通过应用内反馈提交问题，也可以联系支持邮箱。</p>
        <a class="support-email" href={`mailto:${site.supportEmail}`}>
          {site.supportEmail}
        </a>
      </div>
      <a class="button" href="/guides/feedback/">
        怎样提交有效反馈<span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</SiteLayout>
<script>
  const input = document.querySelector<HTMLInputElement>("#guide-search");
  const filters = [
    ...document.querySelectorAll<HTMLButtonElement>(".guide-filters button"),
  ];
  const cards = [
    ...document.querySelectorAll<HTMLElement>(".searchable-guide"),
  ];
  const count = document.querySelector<HTMLElement>("#guide-count");
  const empty = document.querySelector<HTMLElement>("#empty-guides");
  let category = "all";
  function updateGuides() {
    const query = input?.value.trim().toLocaleLowerCase() ?? "";
    let visible = 0;
    cards.forEach((card) => {
      const matches =
        (category === "all" || card.dataset.category === category) &&
        (card.dataset.search ?? "").toLocaleLowerCase().includes(query);
      card.hidden = !matches;
      if (matches) visible++;
    });
    if (count)
      count.textContent =
        query || category !== "all"
          ? `找到 ${visible} 篇指南`
          : `共 ${visible} 篇指南`;
    if (empty) empty.hidden = visible !== 0;
    filters.forEach((button) => {
      const selected = button.dataset.category === category;
      button.classList.toggle("selected", selected);
      button.setAttribute("aria-pressed", String(selected));
    });
  }
  input?.addEventListener("input", updateGuides);
  filters.forEach((button) =>
    button.addEventListener("click", () => {
      category = button.dataset.category ?? "all";
      updateGuides();
    }),
  );
  document.querySelector("#reset-guides")?.addEventListener("click", () => {
    category = "all";
    if (input) input.value = "";
    updateGuides();
    input?.focus();
  });
</script>
<style>
  .page-hero .breadcrumbs {
    margin-bottom: 36px;
  }
  .guide-search {
    max-width: 680px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 22px;
    min-height: 64px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: rgba(13, 18, 64, 0.88);
    margin-top: 34px;
    color: var(--muted);
  }
  .guide-search:focus-within {
    border-color: #e8c77a;
    outline: 2px solid rgba(232, 199, 122, 0.25);
    outline-offset: 4px;
  }
  .guide-search input {
    width: 100%;
    padding-block: 18px;
    border: 0;
    background: none;
    color: var(--text);
    min-width: 0;
    font-size: 16px;
    outline: 0;
  }
  .guide-search input::placeholder {
    color: #9aa3d6;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .guides-library {
    padding-bottom: 88px;
  }
  .guide-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
    padding-bottom: 24px;
    margin-bottom: 36px;
  }
  .guide-filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .guide-filters button {
    font-size: 14px;
    color: #e8c77a;
    padding: 10px 16px;
    min-height: 44px;
    border: 1px solid rgba(232, 199, 122, 0.6);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }
  .guide-filters button:hover {
    background: rgba(232, 199, 122, 0.1);
  }
  .guide-filters button.selected {
    color: #1a1430;
    background: #e8c77a;
    border-color: #e8c77a;
  }
  #guide-count {
    font-size: 13px;
    white-space: nowrap;
    color: var(--muted);
    margin: 0;
  }
  .searchable-guide {
    display: flex;
    min-width: 0;
  }
  .searchable-guide[hidden] {
    display: none;
  }
  .guides-library .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .guide-card {
    --text: #202b3d;
    --muted: #657083;
    --teal: #756129;
    --line: rgba(31, 43, 60, 0.16);
    width: 100%;
    min-height: 274px;
    display: flex;
    flex-direction: column;
    color: var(--text);
    background: #f4efe3;
    border-radius: 4px;
    padding: 26px 28px 22px;
    border-top: 4px solid #e8c77a;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
  }
  .guide-card:hover {
    background: #fff9ec;
  }
  .guide-card:focus-visible {
    outline: 3px solid #8da8ff;
    outline-offset: 5px;
  }
  .guide-card-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 22px;
  }
  .category {
    color: var(--teal);
    font-size: 13px;
  }
  .guide-number {
    color: #a39370;
    font-family: "Starbook Cinzel", serif;
    font-size: 17px;
    line-height: 1;
  }
  .guide-card h2 {
    font-family: "Starbook Noto Serif SC", serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: 0.02em;
    margin: 0 0 14px;
  }
  .guide-card p {
    font-size: 14px;
    line-height: 1.9;
    color: var(--muted);
    margin: 0 0 24px;
  }
  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 12px;
  }
  .card-bottom span:last-child {
    font-size: 22px;
    color: var(--teal);
  }
  .empty-guides {
    padding: 56px 28px;
    text-align: center;
    border: 1px dashed rgba(232, 199, 122, 0.5);
    background: #0d1240;
  }
  .empty-guides[hidden] {
    display: none;
  }
  .empty-guides h2 {
    font-size: 26px;
  }
  .empty-guides p {
    font-size: 14px;
    color: var(--muted);
    margin: 14px 0 26px;
  }
  .help-contact {
    padding-bottom: 104px;
  }
  .cta-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 28px;
    padding: 36px 40px;
    background: #0d1240;
    border: 1.5px dashed rgba(232, 199, 122, 0.65);
    border-radius: 8px;
  }
  .cta-panel h2 {
    font-family: "Starbook Noto Serif SC", serif;
    font-weight: 600;
    font-size: 28px;
    margin: 0 0 12px;
  }
  .cta-panel p {
    color: var(--muted);
    margin: 0;
  }
  .support-email {
    display: inline-block;
    margin-top: 15px;
    font-size: 15px;
    color: #e8c77a;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  @media (max-width: 1000px) {
    .guides-library .guide-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 650px) {
    .page-hero .lede br {
      display: none;
    }
    .guide-toolbar {
      display: block;
      padding-bottom: 24px;
    }
    .guide-filters {
      gap: 8px;
    }
    .guide-filters button {
      font-size: 13px;
      padding: 10px 13px;
    }
    #guide-count {
      margin: 20px 0 0;
    }
    .guides-library {
      padding-bottom: 56px;
    }
    .guides-library .guide-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .guide-card {
      padding: 24px;
      min-height: 250px;
    }
    .empty-guides {
      padding: 35px 20px;
    }
    .empty-guides h2 {
      font-size: 22px;
    }
    .empty-guides p {
      font-size: 14px;
    }
    .help-contact {
      padding-bottom: 64px;
    }
    .cta-panel {
      padding: 28px 24px;
    }
    .guide-search {
      min-height: 60px;
      padding-inline: 16px;
    }
    .page-hero .breadcrumbs {
      margin-bottom: 28px;
    }
  }
</style>

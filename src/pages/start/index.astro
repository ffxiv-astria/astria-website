---
import QRCode from "qrcode";
import StarbookLayout from "../../layouts/StarbookLayout.astro";
import { site } from "../../data/site";
const appStoreQR = await QRCode.toDataURL(site.appStoreURL, {
  width: 220,
  margin: 1,
  color: { dark: "#071014", light: "#ffffff" },
});
---

<StarbookLayout
  title="天穹 App 下载与微信小程序入口 — FF14 国服工具"
  description="下载天穹 iPhone、iPad App，或在微信搜索 FF14检索工具小程序。了解系统要求、Mac 兼容信息和 Android 测试状态。"
  active="start"
>
  <section class="page-hero wrap" id="download">
    <p class="eyebrow">把天穹带在身边</p>
    <h1>
      选一个顺手的入口，
      <br />
      开始你的下一次冒险。
    </h1>
    <p class="lede">
      下载 App，或在微信里随手查询。
      <br />
      无论从哪里开始，都可以先了解功能，再按需要登录。
    </p>
  </section>
  <section class="wrap start-options" aria-label="使用入口">
    <article class="platform-card apple-card sc-paper" id="apple">
      <div class="platform-card-heading">
        <img
          src="/brand/astria-app-icon.png"
          alt="天穹 App 图标"
          width="58"
          height="58"
        />
        <span class="pill teal">正式版 · App Store</span>
      </div>
      <p class="eyebrow">APPLE APP</p>
      <h2>
        在 iPhone 和 iPad 上，
        <br />
        用天穹。
      </h2>
      <p class="platform-description">
        原生界面、系统分享与适合大屏的布局，
        <br />
        把常用资料、工具与玩家内容放在一起。
      </p>
      <div class="apple-download">
        <div>
          <a class="app-store-badge" href={site.appStoreURL}>
            <img
              src="/brand/download-on-the-app-store-zh-cn.svg"
              alt="在 App Store 下载"
              height="50"
            />
          </a>
          <p class="download-hint">手机直接打开，电脑也可以扫码。</p>
        </div>
        <figure class="download-qr">
          <img
            src={appStoreQR}
            alt="App Store 下载链接二维码"
            width="110"
            height="110"
          />
          <figcaption>扫码前往 App Store</figcaption>
        </figure>
      </div>
      <dl class="requirements">
        <div>
          <dt>iPhone / iPad</dt>
          <dd>iOS / iPadOS 18.6 或更高版本</dd>
        </div>
        <div>
          <dt>兼容 Mac</dt>
          <dd>
            Apple M1 或更新芯片，macOS 15.6 或更高版本；兼容情况以 App Store
            为准。
          </dd>
        </div>
        <div>
          <dt>正式版本</dt>
          <dd>
            1.1.0 <a href="/updates/#ios-1-1-0">查看更新 →</a>
          </dd>
        </div>
      </dl>
    </article>
    <article class="platform-card wechat-card sc-paper" id="wechat">
      <div class="platform-card-heading">
        <span class="wechat-mark" aria-hidden="true">
          <svg width="38" height="34" viewBox="0 0 38 34" fill="none">
            <path
              d="M22 14.5C22 20.3 17.3 25 11.5 25c-1.2 0-2.4-.2-3.5-.6L3 27l1.2-5C2.2 20.1 1 17.4 1 14.5 1 8.7 5.7 4 11.5 4S22 8.7 22 14.5Z"
              fill="currentColor"
            />
            <path
              d="M17 21c0 5 4.3 9 9.5 9 1.2 0 2.4-.2 3.4-.6L34 32l-.9-4.4C34.9 26 36 23.6 36 21c0-5-4.3-9-9.5-9S17 16 17 21Z"
              fill="#0e1920"
              stroke="currentColor"
              stroke-width="1.7"
            />
            <circle cx="8" cy="13" r="1.2" fill="#0e1920" />
            <circle cx="15" cy="13" r="1.2" fill="#0e1920" />
            <circle cx="23" cy="20" r="1" fill="currentColor" />
            <circle cx="30" cy="20" r="1" fill="currentColor" />
          </svg>
        </span>
        <span class="pill">微信小程序</span>
      </div>
      <p class="eyebrow">WECHAT MINI PROGRAM</p>
      <h2>
        在微信里，
        <br />
        随手查一查。
      </h2>
      <p class="platform-description">
        不用安装 App。查资料、看行情、翻翻招募，
        <br />
        从微信里熟悉的入口开始。
      </p>
      <div class="wechat-code-layout">
        <figure class="wechat-code">
          <img
            src="/brand/wechat-miniapp-code.jpg"
            alt="FF14检索工具官方微信小程序码"
            width="128"
            height="128"
          />
          <figcaption>微信扫码 · 微信内可长按识别</figcaption>
        </figure>
        <div class="miniapp-search">
          <span class="search-caption">也可在微信中搜索</span>
          <div>
            <strong>{site.miniappName}</strong>
            <button
              id="copy-miniapp"
              type="button"
              aria-label="复制微信小程序名称"
            >
              复制名称
            </button>
          </div>
          <span id="copy-status" role="status" aria-live="polite">
            也可长按选择名称复制
          </span>
        </div>
      </div>
      <ol class="open-steps">
        <li>
          <span>01</span>
          <div>打开微信，进入搜索</div>
        </li>
        <li>
          <span>02</span>
          <div>搜索「{site.miniappName}」</div>
        </li>
        <li>
          <span>03</span>
          <div>在小程序结果中打开，选择所需功能</div>
        </li>
      </ol>
      <a class="text-link" href="/features/#platforms">
        了解 App 与小程序的区别<span aria-hidden="true">→</span>
      </a>
    </article>
  </section>
  <section class="wrap android-status" id="android">
    <div>
      <span class="pill">Android · 测试版本</span>
      <h2>Android 也在继续完善。</h2>
      <p>
        支持 Android 8.0 或更高版本，面向手机与平板。
        <br />
        目前处于测试阶段，官网暂不提供公开下载入口。
      </p>
      <p>现在需要查资料、看行情，可以先使用微信小程序。</p>
    </div>
    <div class="android-actions">
      <a class="button" href="#wechat">
        使用微信小程序<span aria-hidden="true">↑</span>
      </a>
      <a class="text-link" href="/features/#platforms">
        查看功能与界面<span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">开始之前，你可能想知道</p>
        <h2>
          换一个入口，
          <br />
          也认得自己的账号。
        </h2>
      </div>
      <p>
        先确认原来的账号和数据保存方式，
        <br />
        继续使用时会更顺手。
      </p>
    </div>
    <div class="start-guides">
      <a href="/guides/account-sync/">
        <span>账号与同步</span>
        <h3>已经在小程序里用过了？</h3>
        <p>
          给原账号绑定邮箱，再在 App
          使用同一邮箱登录。已分别创建的账号不会合并。
        </p>
        <span class="text-link">查看操作说明 →</span>
      </a>
      <a href="/guides/accounts/">
        <span>官方服务授权</span>
        <h3>叨鱼账号需要重新注册吗？</h3>
        <p>天穹账号与叨鱼授权用途不同。连接官方服务前，先了解各自负责什么。</p>
        <span class="text-link">了解账号关系 →</span>
      </a>
      <a href="/guides/getting-started/">
        <span>第一次使用</span>
        <h3>先从哪个功能开始？</h3>
        <p>
          选好服务器，从一次熟悉的查询开始。需要保存或互动时，再按页面提示登录。
        </p>
        <span class="text-link">阅读入门指南 →</span>
      </a>
    </div>
  </section>
</StarbookLayout>
<script>
  const button = document.querySelector<HTMLButtonElement>("#copy-miniapp");
  const status = document.querySelector<HTMLElement>("#copy-status");
  button?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText("FF14检索工具");
      if (status) status.textContent = "已复制，打开微信搜索小程序名称即可";
      button.textContent = "已复制";
    } catch {
      if (status) status.textContent = "请长按选择「FF14检索工具」并复制";
    }
  });
</script>
<style>
  .start-options { display:grid; grid-template-columns:1fr 1fr; gap:28px; }
  .platform-card { padding:36px; position:relative; scroll-margin-top:28px; }
  .platform-card:before { content:""; position:absolute; width:96px; height:22px; background:#d5ba7980; top:-11px; left:calc(50% - 48px); transform:rotate(-3deg); }
  .wechat-card { background:#e4e9f4; }
  .wechat-card:before { background:#a4b2d680; transform:rotate(4deg); }
  .platform-card-heading { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:30px; }
  .platform-card-heading>img { border-radius:14px; box-shadow:0 5px 12px #17213c22; }
  .wechat-mark { height:58px; width:58px; display:grid; place-items:center; border-radius:15px; background:#d4dfdc; color:#57786b; flex:none; }
  .platform-card h2 { font-size:31px; line-height:1.6; }
  .platform-card .eyebrow { font-family:var(--sb-latin); font-size:12px; letter-spacing:.12em; }
  .platform-description { font-size:14px; color:var(--muted); margin-bottom:0; }
  .apple-download { display:flex; align-items:center; justify-content:space-between; gap:15px; margin:28px 0; padding-block:18px; border-block:1px dashed var(--line); }
  .app-store-badge { display:inline-flex; padding:12.5px; }
  .app-store-badge img { height:50px; width:auto; max-width:none; display:block; }
  .download-hint { font-size:11px; color:var(--muted); margin:3px 0 0; }
  .download-qr { margin:0; flex-shrink:0; text-align:center; }
  .download-qr img { display:block; border:5px solid white; border-radius:2px; width:100px; height:100px; }
  .download-qr figcaption { font-size:10px; color:var(--muted); margin-top:8px; }
  .requirements { display:grid; gap:15px; margin:0; }
  .requirements>div { display:grid; grid-template-columns:95px 1fr; gap:12px; font-size:12px; line-height:1.9; }
  .requirements dt { color:var(--soft); }
  .requirements dd { margin:0; color:var(--muted); }
  .requirements dd a { color:var(--teal); margin-left:7px; white-space:nowrap; }
  .wechat-code-layout { display:grid; grid-template-columns:128px minmax(0,1fr); align-items:center; gap:22px; margin-top:28px; padding:20px 0; border-block:1px dashed var(--line); }
  .wechat-code { margin:0; text-align:center; }
  .wechat-code img { display:block; width:128px; height:128px; object-fit:contain; background:white; }
  .wechat-code figcaption { font-size:10px; color:var(--muted); line-height:1.7; margin-top:8px; }
  .miniapp-search { min-width:0; }
  .search-caption { font-size:11px; color:var(--muted); }
  .miniapp-search>div { margin:10px 0; }
  .miniapp-search strong { font-size:22px; font-weight:600; display:block; line-height:1.6; user-select:all; }
  .miniapp-search button { border:1px solid var(--line-strong); border-radius:3px; padding:8px 12px; margin-top:10px; font-size:12px; background:#f4efe3; color:var(--soft); }
  .miniapp-search button:hover { border-color:var(--teal); color:var(--teal); }
  #copy-status { display:block; line-height:1.7; font-size:11px; color:var(--muted); }
  .open-steps { padding:0; margin:25px 0 12px; list-style:none; display:grid; gap:14px; }
  .open-steps li { display:flex; gap:14px; font-size:13px; color:var(--soft); line-height:1.8; }
  .open-steps li>span { color:var(--teal); font-family:var(--sb-latin); font-size:12px; padding-top:2px; }
  .wechat-card>.text-link { font-size:13px; }
  .android-status { display:flex; align-items:center; justify-content:space-between; gap:35px; border-block:1px dashed var(--line); padding-block:35px; margin-top:40px; }
  .android-status h2 { font-size:28px; margin:18px 0 14px; }
  .android-status p { font-size:14px; color:var(--muted); margin-bottom:8px; }
  .android-actions { display:flex; flex-direction:column; align-items:center; gap:12px; flex-shrink:0; }
  .start-guides { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:28px; }
  .start-guides>a { padding-top:22px; border-top:1px dashed var(--line-strong); }
  .start-guides>a>span:first-child { font-family:var(--sb-hand); font-size:24px; color:var(--teal); }
  .start-guides h3 { font-size:21px; margin:14px 0; }
  .start-guides p { font-size:14px; color:var(--muted); }
  @media(max-width:1050px) {
    .platform-card { padding:28px; }
    .apple-download { flex-wrap:wrap; }
    .download-qr { display:flex; align-items:center; gap:12px; text-align:left; }
    .download-qr img { width:78px; height:78px; }
    .download-qr figcaption { max-width:80px; }
    .requirements>div { grid-template-columns:80px 1fr; }
    .wechat-code-layout { grid-template-columns:1fr; gap:16px; }
    .wechat-code { display:flex; align-items:center; gap:18px; text-align:left; }
    .wechat-code img { flex:none; }
    .wechat-code figcaption { max-width:110px; }
  }
  @media(max-width:700px) {
    .start-options { grid-template-columns:1fr; gap:35px; }
    .platform-card { padding:30px 26px; }
    .platform-card h2 { font-size:29px; }
    .apple-card h2 { font-size:26px; }
    .page-hero .lede br { display:none; }
    .platform-card-heading { margin-bottom:25px; }
    .apple-download { flex-wrap:nowrap; gap:10px; }
    .download-qr { display:block; text-align:center; }
    .download-qr figcaption { max-width:none; }
    .download-hint { max-width:190px; }
    .wechat-code-layout { grid-template-columns:112px minmax(0,1fr); gap:18px; }
    .wechat-code { display:block; text-align:center; }
    .wechat-code img { width:112px; height:112px; }
    .wechat-code figcaption { max-width:none; }
    .miniapp-search strong { font-size:20px; }
    .android-status { display:block; }
    .android-status h2 { font-size:26px; }
    .android-actions { align-items:flex-start; margin-top:24px; }
    .start-guides { grid-template-columns:1fr; gap:25px; }
  }
  @media(max-width:380px) {
    .apple-download { flex-wrap:wrap; gap:16px; }
    .download-qr { display:flex; text-align:left; }
    .wechat-code-layout { grid-template-columns:1fr; justify-items:center; text-align:center; }
    .wechat-code figcaption { max-width:150px; }
  }
</style>

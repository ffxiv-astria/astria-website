---
import { canonicalURL, isPrivateShell } from '../lib/seo';

interface Props {
	title?: string;
	description?: string;
	/** 不让搜索引擎收录（分享承接页承载 UGC 与带凭证的链接）。 */
	noindex?: boolean;
	/** 链接卡片用的 Open Graph 图片，完整 URL。 */
	ogImage?: string;
	/** 铺满刘海与底部指示条区域，env(safe-area-inset-*) 才有值。只给 App 内嵌页用。 */
	viewportFitCover?: boolean;
	/** 仅公共内容页设置规范地址，不包含查询参数。 */
	canonicalPath?: string;
	structuredData?: Record<string, unknown>;
	ogImageAlt?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogType?: string;
}

const {
	title = 'Astria天穹',
	description = 'Astria天穹公共服务。',
	noindex = false,
	ogImage,
	viewportFitCover = false,
	canonicalPath,
	structuredData,
	ogImageAlt = 'Astria天穹，FF14 国服玩家的资料与日常工具',
	ogImageWidth,
	ogImageHeight,
	ogType = 'website',
} = Astro.props;
const effectiveNoindex = noindex || isPrivateShell(Astro.url.pathname);
const publicPath = canonicalPath ?? (
	Astro.url.pathname.startsWith('/legal/') || Astro.url.pathname === '/account-deletion/'
		? Astro.url.pathname
		: undefined
);
const canonical = !effectiveNoindex && publicPath ? canonicalURL(publicPath) : undefined;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content={`width=device-width, initial-scale=1${viewportFitCover ? ', viewport-fit=cover' : ''}`}
		/>
		<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 96x96 256x256" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		{canonical && <link rel="canonical" href={canonical} />}
		{effectiveNoindex && <meta name="robots" content="noindex, nofollow" />}
		{ogImage && (
			<>
				<meta property="og:type" content={ogType} />
				<meta property="og:site_name" content="Astria天穹" />
				<meta property="og:title" content={title} />
				<meta property="og:description" content={description} />
				<meta property="og:image" content={ogImage} />
				<meta property="og:image:alt" content={ogImageAlt} />
				{ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
				{ogImageHeight && <meta property="og:image:height" content={ogImageHeight} />}
				<meta property="og:locale" content="zh_CN" />
				{canonical && <meta property="og:url" content={canonical} />}
				<meta name="twitter:card" content="summary_large_image" />
				<meta name="twitter:title" content={title} />
				<meta name="twitter:description" content={description} />
				<meta name="twitter:image" content={ogImage} />
				<meta name="twitter:image:alt" content={ogImageAlt} />
			</>
		)}
		{structuredData && !effectiveNoindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		--bg: #070910;
		--bg-2: #0e121c;
		--surface: rgba(20, 25, 36, 0.82);
		--surface-strong: rgba(30, 37, 52, 0.94);
		--line: rgba(184, 203, 223, 0.18);
		--line-strong: rgba(184, 203, 223, 0.3);
		--text: #f5f7fb;
		--muted: #aeb8c8;
		--soft: #d6dee9;
		--teal: #62e6dd;
		--violet: #9f8cff;
		--gold: #e7bd62;
		--rose: #ed7c92;
		--ok: #8ce3a1;
		--shadow: 0 24px 70px rgba(0, 0, 0, 0.34);
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
			'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background:
			radial-gradient(circle at 17% 12%, rgba(98, 230, 221, 0.16), transparent 26rem),
			radial-gradient(circle at 86% 2%, rgba(231, 189, 98, 0.12), transparent 24rem),
			linear-gradient(180deg, var(--bg), #0b0f18 46%, #070910);
		color: var(--text);
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	:global(button),
	:global(input),
	:global(select),
	:global(textarea) {
		font: inherit;
	}

	:global(::selection) {
		background: rgba(98, 230, 221, 0.28);
	}
</style>
